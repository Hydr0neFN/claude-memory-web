[Unit]
Description=Memory replication heartbeat (every minute)

[Timer]
# Early: a node that was promoted away from while it was down boots with
# ROLE=primary and memgate starts its units; this heartbeat is what fences it
# once it sees the public hostname served by the peer.
OnBootSec=15s
OnUnitActiveSec=1min
AccuracySec=5s

[Install]
WantedBy=timers.target
