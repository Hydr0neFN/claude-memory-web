#!/bin/sh
# Vault post-commit hook, installed as <data>/.git/hooks/post-commit on both
# nodes: @INST@ -> the vault's instance, @PROTO@ -> "protocol.md" in the
# owner vault (memprotocol-sync's source) and "" everywhere else.
# Never blocks or fails a commit.
INST=@INST@
PROTO=@PROTO@
# Replication: poke memsync-push@<inst>.path.
touch "/var/lib/claude-memory/repl/push.$INST" 2>/dev/null
# The owner's protocol changed: poke memprotocol-sync.path.
if [ -n "$PROTO" ] &&
   git diff-tree --root --no-commit-id --name-only -r HEAD 2>/dev/null | grep -qxF "$PROTO"; then
    touch /var/lib/claude-memory/repl/protocol-sync 2>/dev/null
fi
exit 0
