#!/bin/bash
# ExecCondition= for every memory unit: start only on the node holding the
# writer lease. A non-zero exit makes systemd SKIP the start without failing
# the unit, so Restart=on-failure cannot revive a node whose lease is gone.
# It only reads; it never starts, stops or syncs anything.
. "$(dirname "$(readlink -f "$0")")/lib.sh"
r=$(role)
if [ "$r" = primary ]; then exit 0; fi
log "gate: ROLE=$r, not starting ${1:-memory unit}"
exit 1
