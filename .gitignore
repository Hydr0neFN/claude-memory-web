# Real memory categories dropped here as extra render-test input. They are
# personal notes, not test data -- fixtures/ holds the synthetic corpus the
# tests actually ship with. Anything at the top level except README stays out.
/*.md
!/README.md

__pycache__/
*.pyc
.DS_Store

# Never: the OAuth client secret and the API token live here on a deployed box,
# and this repo is public. auth.json is created by manage_auth.py, not by a
# checkout.
auth.json
auth.json.tmp
apikeys.json
apikeys.json*.tmp
.env
